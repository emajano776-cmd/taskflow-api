# Copia este archivo a .env y llena tus valores reales. Nunca commitees .env

# Cadena de conexión a MySQL: mysql://usuario:password@host:puerto/nombre_db
DATABASE_URL="mysql://root:password@localhost:3306/taskflow"

# Cualquier cadena larga y aleatoria sirve. Genera una con: openssl rand -hex 32
JWT_SECRET="cambia-esto-por-algo-random-y-largo"

PORT=3000
NODE_ENV=development

# Personal Access Token de GitHub, para el MCP de opencode.json
# Crear en: https://github.com/settings/tokens (scopes: repo)
GITHUB_PAT="ghp_xxxxxxxxxxxxxxxxxxxx"
